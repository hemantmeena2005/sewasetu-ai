# ==============================================================================
# Sewa Setu — Production Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Never commit real credentials or production secrets to version control.
# 2. Copy this file to '.env.production' on the target deployment host.
# 3. Populate all placeholders using a secure secret manager (e.g. OpenStack Barbican,
#    HashiCorp Vault, or AWS Secrets Manager).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=sewasetu
POSTGRES_USER=sewasetu
POSTGRES_PASSWORD=generate_a_strong_random_password_minimum_32_chars_here
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Application Core & Session Security
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure random secret key (e.g., openssl rand -hex 32)
SECRET_KEY=generate_256bit_hex_secret_key_here
JWT_SECRET_KEY=generate_256bit_hex_secret_key_here

# Departmental administrative credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate_a_strong_unique_admin_password_here
OFFICER_DEFAULT_PASSWORD=generate_a_strong_unique_officer_password_here

# ------------------------------------------------------------------------------
# 3. Host & URL Endpoints
# ------------------------------------------------------------------------------
# Authoritative public URL where citizens and external AI assistants access the portal
PUBLIC_BASE_URL=https://sewasetu.purvanchal.gov.in
EXTERNAL_PORT=443

# ------------------------------------------------------------------------------
# 4. Storage & Logging Directories
# ------------------------------------------------------------------------------
# Mount points on the persistent Cinder block volume
UPLOAD_DIR=/var/sewasetu/uploads
LOG_DIR=/var/log/sewasetu

# ------------------------------------------------------------------------------
# 5. External SMS Gateway & OTP Service
# ------------------------------------------------------------------------------
# Telecom SMS Provider API URL and production authentication credentials
SMS_GATEWAY_URL=https://sms-api.purvanchal.gov.in
SMS_API_KEY=telecom_provider_production_api_key_placeholder
SMS_SENDER_ID=SEWAST
OTP_VALIDITY_SECONDS=300

# ------------------------------------------------------------------------------
# 6. Policy & SLA Business Rules
# ------------------------------------------------------------------------------
MIN_AGE=60
SLA_DAYS=15
SCHEME_DEADLINE=2026-10-31 23:59
